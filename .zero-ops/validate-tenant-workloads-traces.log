kind: Rollout
metadata:
  annotations:
    rollout.argoproj.io/revision: "2"
  creationTimestamp: "2026-05-28T07:12:53Z"
  generation: 2
  labels:
    app: bff
    argocd.argoproj.io/instance: tenant-waypoint-workloads
    cost-center: platform
    tenant-id: waypoint
    workload-class: stateless-web
  name: bff-workload
  namespace: tenant-waypoint
  resourceVersion: "645537"
  uid: b34ff8f8-affa-43ee-b4da-dff03b6d5169
spec:
  replicas: 2
  selector:
    matchLabels:
      app: workload
  strategy:
    canary:
      steps:
      - setWeight: 20
      - pause:
          duration: 5m
      - setWeight: 50
      - pause:
          duration: 5m
  template:
    metadata:
      annotations:
        prometheus.io/port: "9090"
        prometheus.io/scrape: "true"
      labels:
        app: workload
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - podAffinityTerm:
              labelSelector:
                matchLabels:
                  app: workload
              topologyKey: kubernetes.io/hostname
            weight: 100
      containers:
      - image: ghcr.io/soloz-io/waypoint/bff@sha256:a50e1dc0b14119a374cff7131b632235c9fdca8279ffcb4758b9fddfbf1d842e
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 15
          periodSeconds: 10
        name: app
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 5
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
      imagePullSecrets:
      - name: ghcr-pull-secret
      securityContext:
        fsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: bff-workload-sa
      topologySpreadConstraints:
      - labelSelector:
          matchLabels:
            app: workload
        maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: DoNotSchedule
