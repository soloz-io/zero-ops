spec:
  replicas: 2
  selector:
    matchLabels:
      app: workload
  strategy:
    canary:
      steps:
      - setWeight: 20
      - pause:
          duration: 5m
      - setWeight: 50
      - pause:
          duration: 5m
  template:
    metadata:
      annotations:
        prometheus.io/port: "9090"
        prometheus.io/scrape: "true"
      labels:
        app: workload
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - podAffinityTerm:
              labelSelector:
                matchLabels:
                  app: workload
              topologyKey: kubernetes.io/hostname
            weight: 100
      containers:
      - image: ghcr.io/soloz-io/waypoint/bff@sha256:a50e1dc0b14119a374cff7131b632235c9fdca8279ffcb4758b9fddfbf1d842e
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 15
          periodSeconds: 10
        name: app
        readinessProbe:
          failureThreshold: 3
          httpGet:
