# Dockerignore for monorepo builds
# Only exclude what's not needed for build

# Git
.git/
.gitignore
.gitmodules

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test files (but keep source)
*_test.go
test/
tests/
*.test

# CI/CD
.github/

# Kiro
.kiro/

# Archives
archived/

# Memory
memory/

# Documentation
docs/

# Secrets at root level only (not operator internal packages)
/secrets/

# Misc
.aidigestignore
*.kubeconfig
plan.md
deploy-*.sh
verify-*.sh

# Keep operators directory and all its contents
!operators/

