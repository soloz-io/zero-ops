---
# Spoke-managed certificates using Infisical CA issuer
# These replace the hub-distributed certificates from ADR-035
# cert-manager on the spoke handles renewal automatically

# Alloy (Grafana Alloy) client mTLS certificate
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: alloy-client-cert
  namespace: platform-observability
spec:
  secretName: alloy-client-cert
  duration: 2160h  # 90 days
  renewBefore: 168h  # 7 days
  usages:
    - client auth
    - digital signature
    - key encipherment
  commonName: alloy-client
  issuerRef:
    name: infisical-ca
    kind: ClusterIssuer

# NATS Leafnode client mTLS certificate
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: nats-leafnode-client-cert
  namespace: platform-messaging
spec:
  secretName: nats-leafnode-client-cert
  duration: 2160h  # 90 days
  renewBefore: 168h  # 7 days
  usages:
    - client auth
    - digital signature
    - key encipherment
  commonName: nats-leafnode-client
  issuerRef:
    name: infisical-ca
    kind: ClusterIssuer
