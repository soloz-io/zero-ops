apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: platform-spire
  namespace: platform-ops
  annotations:
    argocd.argoproj.io/sync-wave: "5"
spec:
  project: default
  source:
    repoURL: https://github.com/soloz-io/zero-ops
    targetRevision: HEAD
    path: manifests/hub-core-services/spire
  destination:
    server: https://kubernetes.default.svc
    namespace: platform-security
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
