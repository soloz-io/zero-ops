{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-Mail",
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true }
            }
          }
        },
        "tenant_id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["tenant_admin", "platform_admin"]
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
