{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "infisical"
  ],
  "properties": {
    "infisical": {
      "type": "object",
      "required": [
        "auth"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "fleet": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            }
          }
        },
        "signing": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            }
          }
        },
        "auth": {
          "type": "object",
          "required": [
            "secretName",
            "secretKey"
          ],
          "properties": {
            "secretName": {
              "type": "string",
              "minLength": 1
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "certificateTemplate": {
      "type": "object",
      "properties": {
        "fleet": {
          "type": "string"
        },
        "signing": {
          "type": "string"
        }
      }
    }
  }
}
