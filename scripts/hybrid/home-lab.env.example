# Home lab node registry — hybrid provider (ADR-046 §WS3)
# ─────────────────────────────────────────────────────────────────────────────
# Format (one line per WSL2 worker node):
#   <hostname>|<ssh-target>|<wsl-distro>|<tailnet-host>|<box-tag>
#
# Fields:
#   hostname    : kubernetes node hostname (must be unique in the cluster)
#   ssh-target  : user@ip or user@hostname for SSH access from the Mac
#   wsl-distro  : WSL2 distro name (wsl -d <distro>)
#   tailnet-host: Tailscale MagicDNS hostname (e.g. hostname.tailnet.ts.net)
#   box-tag     : human label for the physical box (box-a, box-b, etc.)
#
# IMPORTANT: Copy this file to home-lab.env and fill in real values.
# home-lab.env is gitignored; this example ships safe placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# Box A: Dell workstation (10.57.194.147 — existing home node)
HOME_WORKER_NODES="wsl2-node-1|user@10.57.194.147|Ubuntu-24.04|wsl2-node-1.REPLACE_TAILNET.ts.net|box-a"

# Box B: placeholder — fill in after physical setup and Tailscale enrollment
HOME_WORKER_NODES="$HOME_WORKER_NODES
wsl2-node-2|user@REPLACE_IP|Ubuntu-24.04|wsl2-node-2.REPLACE_TAILNET.ts.net|box-b"

# Tailscale tailnet name (e.g. example.ts.net)
TAILNET_NAME="REPLACE_TAILNET.ts.net"

# Hybrid spoke pool name (matches the SpokePool claim name)
HYBRID_SPOKE_NAME="spoke-pool-hybrid-dev-01"

# Hub kubeconfig path (used by join scripts to read spoke kubeconfig)
HUB_KUBECONFIG="${ZERO_OPS_DIR:-$(git rev-parse --show-toplevel)}/k8-secrets/kubeconfig/hub.kubeconfig"
