[Unit]
Description=Tailscale + Kubelet self-healing watchdog
Documentation=https://github.com/soloz-io/ide/tree/main/zero-ops/scripts/hybrid/wsl2
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/tailscale-watchdog.sh
# Don't fail if script exits non-zero — timer will retry next cycle
SuccessExitStatus=0 1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tailscale-watchdog
